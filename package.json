{
  "name": "ecdf",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Minimal research prototype for reproducible settlement experiments.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "health": "npm run build --silent && node dist/src/index.js",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run health"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "17.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
